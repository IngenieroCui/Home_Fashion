{
  "name": "@home-fashion/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:migrate:status": "tsx src/database/cli.ts migrate:status",
    "db:migrate:undo": "tsx src/database/cli.ts migrate:undo",
    "db:migrate:undo:all": "tsx src/database/cli.ts migrate:undo:all",
    "db:seed": "tsx src/database/cli.ts seed",
    "db:seed:status": "tsx src/database/cli.ts seed:status",
    "db:seed:undo": "tsx src/database/cli.ts seed:undo",
    "db:seed:undo:all": "tsx src/database/cli.ts seed:undo:all",
    "demo:seed": "tsx src/database/demo-seed.ts",
    "admin:create": "tsx src/admin-create.ts",
    "user:create": "tsx src/user-create.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/sequelize": "^11.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
