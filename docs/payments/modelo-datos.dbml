// Minimal extension; existing tables abbreviated. No second financial ledger.
Table sales {
 id bigint [pk]
 total decimal(12,2)
}
Table users {
 id bigint [pk]
}
Table sale_payments {
 id bigint [pk]
 sale_id bigint [not null, ref: > sales.id]
 intent_id varchar(36) [unique, note: 'NULL only for historical records']
 intent_fingerprint varchar(64)
 amount decimal(12,2) [not null]
}
Table payment_attempts {
 id varchar(36) [pk]
 sale_id bigint [not null, ref: > sales.id]
 provider varchar(12) [not null, default: 'WOMPI']
 reference varchar(80) [not null, unique]
 amount_in_cents bigint [not null]
 currency varchar(3) [not null, default: 'COP']
 environment varchar(12) [not null, default: 'SANDBOX']
 status varchar(20) [not null]
 provider_transaction_id varchar(160) [unique]
 sale_payment_id bigint [unique, ref: - sale_payments.id]
 token_hash varchar(64) [not null, unique]
 expires_at datetime [not null]
 created_by_user_id bigint [not null, ref: > users.id]
 verified_at datetime
 last_event_timestamp bigint
 review_required boolean [not null, default: false]
 review_reason varchar(80)
 created_at datetime [not null]
 updated_at datetime [not null]
}
