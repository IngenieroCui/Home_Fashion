# Do NOT copy credentials from the application's production database.
# Recommended Windows setup: pnpm test:e2e:provision creates a new local MySQL process,
# a dedicated schema, a restricted user and these randomly generated values.
E2E_DEDICATED=true
E2E_RUN_ID=replace-with-generated-run-id
E2E_SERVER_UUID=uuid-of-the-new-dedicated-server
E2E_MARKER=random-marker-in-e2e-isolation-table
DB_HOST=127.0.0.1
DB_PORT=33307
DB_NAME=home_fashion_e2e
DB_USER=hf_e2e
DB_PASSWORD=generate-a-strong-password
E2E_ACTOR_PASSWORD=generate-a-strong-password
JWT_ACCESS_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=generate-another-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder is forced to home-fashion-e2e/<E2E_RUN_ID>, never inherited from production.
