# Local credentials and generated test data must never enter CLI deployments.
.env
.env.*
**/.env
**/.env.*
certs/
**/certs/
*.pem
*.key
*.p12
*.pfx
tmp/
temp/

# Local outputs and material outside the web deployments.
.dart-appdata/
.tmp/
apps/mobile/
docs/
thesis-artifacts/
**/dist/
**/build/
**/coverage/
**/.dart_tool/
**/.next/
**/*.log

# Isolated QA runtime, local databases and browser sessions.
.e2e-local/
.e2e-results/
.e2e-evidence/
**/.e2e-local/
**/.e2e-results/
**/owner.json
**/*storageState*
**/*storage-state*
**/*auth-state*
**/*.db
**/*.sqlite*
**/*.ibd
**/*.sdi
**/*.har
**/*.key
**/*.pem
