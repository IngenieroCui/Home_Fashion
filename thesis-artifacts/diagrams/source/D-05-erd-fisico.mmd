%% D-05 — ERD físico completo (22 tablas; campos clave)
%% Corte histórico del modelo físico. Para el esquema vigente, consultar docs/PROJECT.md.
erDiagram
  categories { bigint id PK string slug UK string name boolean is_active }
  products { bigint id PK bigint category_id FK string slug UK string status }
  product_variants { bigint id PK bigint product_id FK string sku UK decimal sale_price int quantity_on_hand int quantity_reserved }
  product_images { bigint id PK bigint product_id FK bigint product_variant_id FK string url int position }
  roles { bigint id PK string code UK string name }
  permissions { bigint id PK string code UK string description }
  role_permissions { bigint role_id PK,FK bigint permission_id PK,FK }
  users { bigint id PK bigint role_id FK string email UK string password_hash boolean is_active }
  user_permission_overrides { bigint user_id PK,FK bigint permission_id PK,FK string effect }
  refresh_sessions { bigint id PK bigint user_id FK string token_hash UK datetime expires_at datetime revoked_at bigint replaced_by_session_id FK }
  customers { bigint id PK string full_name string document_number UK string phone string email }
  quotes { bigint id PK string code UK bigint customer_id FK string status string public_request_key UK decimal total }
  quote_items { bigint id PK bigint quote_id FK bigint product_id FK bigint product_variant_id FK int quantity decimal unit_quoted_price decimal subtotal }
  sales { bigint id PK string code UK bigint customer_id FK bigint quote_id FK string status decimal total }
  sale_items { bigint id PK bigint sale_id FK bigint product_id FK bigint product_variant_id FK int quantity decimal unit_sale_price decimal subtotal }
  sale_payments { bigint id PK bigint sale_id FK bigint customer_id FK string type string method decimal amount string status }
  orders { bigint id PK string code UK bigint sale_id FK bigint customer_id FK string status }
  order_items { bigint id PK bigint order_id FK bigint sale_item_id FK bigint product_id FK bigint product_variant_id FK string supply_type string status }
  workshop_jobs { bigint id PK bigint order_item_id FK bigint workshop_user_id FK bigint assigned_by_user_id FK string status }
  workshop_progress_reports { bigint id PK bigint workshop_job_id FK bigint submitted_by_user_id FK bigint reviewed_by_user_id FK string type string review_status }
  order_tracking_accesses { bigint id PK bigint order_id FK string token_hash UK datetime expires_at datetime revoked_at }
  deliveries { bigint id PK string code UK bigint order_id FK bigint assigned_user_id FK string status string delivery_type }

  categories ||--o{ products : category_id
  products ||--o{ product_variants : product_id
  products ||--o{ product_images : product_id
