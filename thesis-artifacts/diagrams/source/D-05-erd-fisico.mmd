  users ||--o{ user_permission_overrides : user_id
  permissions ||--o{ user_permission_overrides : permission_id
  users ||--o{ refresh_sessions : user_id
  refresh_sessions o|--o{ refresh_sessions : replaced_by_session_id
  customers ||--o{ quotes : customer_id
  quotes ||--o{ quote_items : quote_id
  products ||--o{ quote_items : product_id
  product_variants o|--o{ quote_items : product_variant_id
  customers ||--o{ sales : customer_id
  quotes o|--o| sales : quote_id
  sales ||--o{ sale_items : sale_id
  products ||--o{ sale_items : product_id
  product_variants o|--o{ sale_items : product_variant_id
  sales ||--o{ sale_payments : sale_id
  customers ||--o{ sale_payments : customer_id
  sales ||--o| orders : sale_id
  customers ||--o{ orders : customer_id
  orders ||--o{ order_items : order_id
  sale_items ||--|| order_items : sale_item_id
  products ||--o{ order_items : product_id
  product_variants o|--o{ order_items : product_variant_id
  order_items ||--o| workshop_jobs : order_item_id
  users ||--o{ workshop_jobs : workshop_user_id
  workshop_jobs ||--o{ workshop_progress_reports : workshop_job_id
