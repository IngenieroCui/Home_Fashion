# SERVER ONLY. Disabled until genuine credentials and HTTPS callback are configured.
WOMPI_ENABLED=false
WOMPI_EXTERNAL_SANDBOX=PENDING_CREDENTIALS
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Generate a random secret of at least 32 characters; keep stable for existing links.
WOMPI_LINK_SECRET=
WOMPI_PUBLIC_WEB_URL=https://your-demo-host.example
WOMPI_SANDBOX_DATABASE_ISOLATED=true
# Phase guard: DB_HOST must be loopback, DB_NAME must contain sandbox or e2e.
# Webhook (API HTTPS origin): /api/payments/wompi/events
